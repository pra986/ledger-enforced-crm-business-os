# Database configuration (local SQLite or production Supabase)
DATABASE_URL=sqlite:///./business_os.db
SUPABASE_URL=your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Copilot settings
COPILOT_SCOPED_TOOLS=read_pipeline,draft_quote,post_journal_entry
COPILOT_ENFORCE_IMMUTABLE_LEDGER=true

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
